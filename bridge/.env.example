# Copy to bridge/.env (git-ignored). Used by run.sh via --env-file.
HA_URL=http://192.168.1.10:8123
HA_TOKEN=paste-a-long-lived-token-here
PORT=8790
# The TV's LAN IP: only it (and localhost) may call /api/call and /api/snapshot
TV_IP=
# Extra IPs allowed to call (comma separated), e.g. a phone for testing
ALLOW_CALL_FROM=
LOG_LEVEL=INFO
# AI 助手 (optional). Without a key the assistant uses simple built-in rules.
GEMINI_API_KEY=
# Tried in order; the first that answers is reused for later requests.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
